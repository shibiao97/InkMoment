{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InkMoment",
  "version": "0.1.0",
  "identifier": "com.inkmoment.desktop",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "beforeBuildCommand": "npm run frontend:build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../static/vue"
  },
  "app": {
    "windows": [
      {
        "title": "InkMoment",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"]
  }
}
