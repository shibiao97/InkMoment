{
  "name": "inkmoment",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "frontend:dev": "npm --workspace frontend run dev",
    "frontend:build": "npm --workspace frontend run build",
    "frontend:preview": "npm --workspace frontend run preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "sidecar:build": "python3 scripts/build_sidecar.py",
    "tauri:build:sidecar": "npm run sidecar:build && INKMOMENT_USE_BUNDLED_SIDECAR=1 tauri build --config src-tauri/tauri.sidecar.conf.json"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1"
  }
}
